# HolidayBooking configuration. Copy to .env (docker compose reads it automatically).
# This file is independent of the main application's .env.

# Host ports
HB_FRONTEND_PORT=8180
HB_BACKEND_PORT=8100
HB_MCP_PORT=8101

# Database (SQL Server). start.sh / start.ps1 pick the server and override HB_DB_HOST / HB_DB_PORT:
#   - an SQL Server already running on localhost:1433 (e.g. the main app's db) is reused,
#     reached from the containers through host.docker.internal;
#   - otherwise HolidayBooking starts its own SQL Server (service "sqlserver", data in a Docker volume).
# Either way HolidayBooking uses its own database, created automatically; migrations create the tables and
# seed the hotel's rooms. HB_DB_PASSWORD is the sa password of the reused server (or the new server's password).
HB_DB_HOST=host.docker.internal
HB_DB_PORT=1433
HB_DB_NAME=holidaybooking
HB_DB_USER=sa
HB_DB_PASSWORD=
HB_SQL_PORT=1434                      # host port of HolidayBooking's own SQL Server, when it starts one
HB_SHARED_SQL_PORT=1433               # port the start scripts probe for an already-running SQL Server

# API keys (required; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# HB_MCP_API_KEYS: given to MCP clients (the main app's MCP page), sent as the X-API-Key header.
#   Comma-separated, so keys can be rotated or issued per client. Without it the MCP server will not start.
# HB_BACKEND_API_KEY: internal key used by the MCP server and the UI proxy to reach the backend API. Keep it
#   secret and different from the MCP key: a leaked MCP key then does not open the backend directly.
HB_MCP_API_KEYS=
HB_BACKEND_API_KEY=

# Staff login. The first superadmin is created by the seeding step (python -m app.migrate) from these values,
# only when no superadmin exists yet; afterwards users are managed in the admin area (/admin.html).
# Change the password after the first login. Passwords of existing users are never touched by a restart.
HB_SUPERADMIN_EMAIL=superadmin@example.com
HB_SUPERADMIN_PASSWORD=
HB_SUPERADMIN_NAME=Super Admin
HB_COOKIE_SECURE=false                # set to true when the site is served over HTTPS

# Backend
HB_MAX_NIGHTS=30                      # longest stay a single booking may cover
# HB_RESERVATIONS_PHONE: the reservations number, with country code (e.g. +14155550100). Shown in the guest page's
# header and given to AI assistants by the MCP get_contact_info tool. Empty: nothing is shown.
HB_RESERVATIONS_PHONE=

# MCP server
MCP_TRANSPORT=streamable-http         # streamable-http (default in docker) or stdio
HB_API_URL=http://backend:8000        # where the MCP server reaches the backend (docker network address)
