# Copy to .env and fill in the keys.
MSSQL_SA_PASSWORD=Receptionist_Pass1

# LLM (provider is selectable: groq | anthropic | openai_compatible | fake)
LLM_PROVIDER=groq
LLM_MODEL=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# openai_compatible only (OpenAI, Gemini, Ollama...):
LLM_BASE_URL=
LLM_API_KEY=

# Voice (Deepgram STT + TTS)
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-asteria-en
DEEPGRAM_STT_MODEL=nova-2

# Phase 1 default tenant / profile (seeded)
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_DOMAIN_PROFILE_ID=00000000-0000-0000-0000-0000000000a1

# Auth (change JWT_SECRET in any shared/production environment)
JWT_SECRET=dev-insecure-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
# Seeded superadmin (created on startup if both are set)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

LOG_LEVEL=INFO
