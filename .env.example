# Copy to .env and fill in the keys.
MSSQL_SA_PASSWORD=Receptionist_Pass1

# LLM (provider is selectable: groq | anthropic | openai_compatible | fake)
LLM_PROVIDER=groq
LLM_MODEL=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# openai_compatible only (OpenAI, Gemini, Ollama...):
LLM_BASE_URL=
LLM_API_KEY=

# Voice (Deepgram STT + TTS)
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-asteria-en
DEEPGRAM_STT_MODEL=nova-2

# Phase 1 default tenant / profile (seeded)
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_DOMAIN_PROFILE_ID=00000000-0000-0000-0000-0000000000a1

# Auth (change JWT_SECRET in any shared/production environment)
JWT_SECRET=dev-insecure-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
# Seeded superadmin (created on startup if both are set)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Email via Twilio SendGrid (new business admins receive their password by email).
# Leave SENDGRID_API_KEY empty in dev: emails are logged instead of sent.
# EMAIL_FROM must be a sender you verified in SendGrid (Settings -> Sender Authentication).
# Check it with: docker compose exec backend python -m app.notifications you@example.com
APP_BASE_URL=http://localhost:5173
SENDGRID_API_KEY=
EMAIL_FROM=

# MCP integrations (admins connect their own MCP servers; tokens are encrypted at rest).
# MCP_SECRET_KEY: optional Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())");
# when empty a key is derived from JWT_SECRET.
# MCP_ALLOW_PRIVATE_HOSTS: true only for local development (MCP server on this machine / private network).
MCP_SECRET_KEY=
MCP_ALLOW_PRIVATE_HOSTS=false
# Docker development: connect to the host machine when an MCP URL says localhost / 127.0.0.1
MCP_LOCALHOST_ALIAS=

# Phone calls and SMS / WhatsApp confirmations (Twilio). See "Phone calls (Twilio)" in README.md.
# PUBLIC_BASE_URL: public https URL of this backend; ./scripts/phone-dev.ps1 fills it in from an ngrok tunnel.
# Leave the Twilio values empty in dev: confirmations are logged instead of sent (calls need them).
PUBLIC_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+
TWILIO_WHATSAPP_FROM=+

# Phone calls through Vapi (alternative to the Twilio stream above). PUBLIC_BASE_URL must be set too.
# VAPI_WEBHOOK_SECRET: the token you configure as the Vapi server credential (Bearer, or header X-Vapi-Secret).
VAPI_WEBHOOK_SECRET=generated-value-here

LOG_LEVEL=INFO
