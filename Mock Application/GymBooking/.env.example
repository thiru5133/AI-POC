# GymBooking configuration. Copy to .env (docker compose reads it automatically).
# This file is independent of the main application's .env.

# Host ports
GB_FRONTEND_PORT=8280
GB_BACKEND_PORT=8200
GB_MCP_PORT=8201

# Database (SQL Server). start.sh / start.ps1 pick the server and override GB_DB_HOST / GB_DB_PORT:
#   - an SQL Server already running on localhost:1433 (e.g. the main app's db) is reused,
#     reached from the containers through host.docker.internal;
#   - otherwise GymBooking starts its own SQL Server (service "sqlserver", data in a Docker volume).
# Either way GymBooking uses its own database, created automatically; migrations create the tables and
# seed the gyms and class types. GB_DB_PASSWORD is the sa password of the reused server (or the new server's password).
GB_DB_HOST=host.docker.internal
GB_DB_PORT=1433
GB_DB_NAME=gymbooking
GB_DB_USER=sa
GB_DB_PASSWORD=
GB_SQL_PORT=1435                      # host port of GymBooking's own SQL Server, when it starts one
GB_SHARED_SQL_PORT=1433               # port the start scripts probe for an already-running SQL Server

# API keys (required; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# GB_MCP_API_KEYS: given to MCP clients (the main app's MCP page), sent as the X-API-Key header.
#   Comma-separated, so keys can be rotated or issued per client. Without it the MCP server will not start.
# GB_BACKEND_API_KEY: internal key used by the MCP server and the UI proxy to reach the backend API. Keep it
#   secret and different from the MCP key: a leaked MCP key then does not open the backend directly.
GB_MCP_API_KEYS=
GB_BACKEND_API_KEY=

# Staff login. The first superadmin is created by the seeding step (python -m app.migrate) from these values,
# only when no superadmin exists yet; afterwards users are managed in the admin area (/admin.html).
# Change the password after the first login. Passwords of existing users are never touched by a restart.
GB_SUPERADMIN_EMAIL=superadmin@example.com
GB_SUPERADMIN_PASSWORD=
GB_SUPERADMIN_NAME=Super Admin
GB_COOKIE_SECURE=false                # set to true when the site is served over HTTPS

# Backend
GB_MAX_DAYS_AHEAD=60                  # how far ahead a class can be booked (days)

# MCP server
MCP_TRANSPORT=streamable-http         # streamable-http (default in docker) or stdio
GB_API_URL=http://backend:8000        # where the MCP server reaches the backend (docker network address)
